# Application Environment
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=petcare_super_secret_key_change_in_production_2026

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vet_center
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/vet_center?charset=utf8mb4

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Mail Configuration (SMTP Testing / Production)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=PetCare Clinic <no-reply@petcare.test>
